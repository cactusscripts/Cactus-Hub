        local alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
        local bytes, acc, bits = {}, 0, 0
        for i = 1, #b64 do
            local chr = b64:sub(i, i)
            if chr == "=" then break end
            local idx = alphabet:find(chr, 1, true)
            if idx then
                acc = acc * 64 + idx - 1
                bits = bits + 6
                if bits >= 8 then
                    bits = bits - 8
                    bytes[#bytes + 1] = string.char(math.floor(acc / 2 ^ bits) % 256)
                    acc = acc % 2 ^ bits
                end
            end
        end
        local path = "CactusHub_Cactus_Transparent.png"
        local ok, err = pcall(writefile, path, table.concat(bytes))
        if ok then
            local asset = nativeAsset(path)
            if asset then return asset end
        else
            warn("[Cactus Hub] Could not save cactus PNG: " .. tostring(err))
        end
    end
