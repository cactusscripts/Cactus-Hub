	function WindowFunctions:SetNotificationsState(State)
		notifications.Visible = State
	end

	function WindowFunctions:GetNotificationsState(State)
		return notifications.Visible
	end

	function WindowFunctions:SetState(State)
		if windowState == State then return end
		windowState = State
		base.Visible = State
		local page = State and not appearance.resizing and appearance.activePage or nil
		ThemeEditor.bouncePage(appearance, page, true)
	end

	function WindowFunctions:GetState()
		return windowState
	end

	function WindowFunctions:GetCurrentTab()
		return currentTab.Text
	end

	function WindowFunctions:IsTabSelected(name)
		return windowState == true and currentTab.Text == tostring(name)
	end

	local onUnloadCallback

	function WindowFunctions:Unload()
        if unloaded then return end
        unloaded = true
        disconnectServices()
		if appearance.draftSave then
			task.cancel(appearance.draftSave)
			appearance.draftSave = nil
			SaveGlobalUISettings()
		end
		if _keyTimerConn then
			_keyTimerConn:Disconnect()
			_keyTimerConn = nil
		end
		if onUnloadCallback then
