        function window:Tab(tabConfig)
            local nativeTab = group:Tab({Name = tabConfig.Title, Icon = tabConfig.Icon})
            local tab = {Native = nativeTab, Title = tabConfig.Title}
            local currentSection, sectionIndex = nil, 0
            if tabConfig.Title == "Info" and not options.CleanBranding then
                nativeTab:Section({Name = "UI Credits", Side = "Right"}):Paragraph({
                    Header = "MacLib", Body = "Visual fork by Lixtron/Hub.\nLocal Kero adaptation."})
            end

            function tab:Select() return nativeTab:Select() end

            function tab:Section(sectionConfig)
                sectionIndex = sectionIndex + 1
                currentSection = nativeTab:Section({Name = sectionConfig.Title,
                    Side = sectionConfig.Side or (sectionIndex % 2 == 1 and "Left" or "Right"),
                    Collapsible = options.SectionTitles == true, Collapsed = false})
                return currentSection
