    assert(type(opts.Load)=="function"and type(opts.Path)=="function"and type(opts.Clean)=="function","Macro import adapter unavailable")
    local I={}
    -- BEGIN KERO MACRO INPUT
local function ResolveMacroInput(value)
    if type(value)~="string"then return nil,"Paste macro JSON or a Discord file link."end
    value=value:match("^%s*(.-)%s*$")
    if value:sub(1,3)=="```"then value=value:sub(4):gsub("%s*```$",""):gsub("^[jJ][sS][oO][nN]%s+",""):match("^%s*(.-)%s*$")end
    if value==""then return nil,"Paste macro JSON or a Discord file link."end
    -- JSON is imported locally. Keep the existing game validation and file-saving checks.
    if value:sub(1,1)=="{" then
        if #value>200*1024 then return nil,"Macro exceeds 200 KB"end
        return value,false
    end
    if value:sub(1,6)=="[Kero]" then value=value:sub(7)
    elseif value:sub(1,8)=="[Cactus]" then value=value:sub(9)end
    local fromLink=true
    do
        if #value>4096 or value:find("[%s%c<>\\]")then return nil,"Paste one complete Discord file link"end
        local host,path=value:match("^https://([^/%?#]+)(/[^#]*)$")
        if not host or not (host:lower()=="cdn.discordapp.com"or host:lower()=="media.discordapp.net")
            or not path:match("^/attachments/%d+/%d+/[^%?#]+")then
            return nil,"Use the Discord file link, not a message or Copy Link page URL"
        end
        local transport=type(request)=="function"and request or type(http_request)=="function"and http_request
            or type(syn)=="table"and type(syn.request)=="function"and syn.request
            or type(http)=="table"and type(http.request)=="function"and http.request
        local ok,result,reason=pcall(function()
            if transport then
                local response=transport({Url=value,Method="GET",Headers={Accept="application/json"},Redirect=false})
                assert(type(response)=="table","Invalid HTTP response")
                local status=tonumber(response.StatusCode or response.Status)
                if status==403 or status==404 then return nil,"Link expired or unavailable; copy a fresh file link from Discord"end
                if status and (status<200 or status>=300)then return nil,"Download failed (HTTP "..status..")"end
                return response.Body or response.body
            end
            return game:HttpGet(value)
        end)
        if not ok then return nil,"Cannot download macro; check the link, network and executor HTTP support"end
        if type(result)~="string"or result==""then return nil,reason or "Link expired or unavailable; copy a fresh file link from Discord"end
        value=result
    end
    if #value>200*1024 then return nil,"Macro exceeds 200 KB"end
    value=value:gsub("^\239\187\191","")
    return value,fromLink
end
-- END KERO MACRO INPUT

    local function snapshot()
        local copies={}
        for _,state in ipairs(opts.StateTables)do
            local copy={};for key,value in pairs(state)do copy[key]=value end
            copies[#copies+1]={State=state,Copy=copy}
        end
        return function()
            for _,entry in ipairs(copies)do
                for key in pairs(entry.State)do entry.State[key]=nil end
                for key,value in pairs(entry.Copy)do entry.State[key]=value end
            end
        end
    end
    local function cleanData(value,depth)
        assert(depth<40,"Macro nesting is too deep")
        if type(value)=="number"then assert(value==value and math.abs(value)<math.huge,"Invalid macro number")end
        if type(value)~="table"then return value end
        local copy={}
        for key,item in pairs(value)do
            local private=type(key)=="string"and (key:lower()=="owneruserid"or key:lower()=="ownerid")
            if not private then copy[key]=cleanData(item,depth+1)end
        end
        return copy
    end
    function I.Import(raw,name)
        if I.Busy or I.Fetching or opts.Busy()then return false,"Stop recording and Auto Playback before importing"end
        if not opts.FS()or type(delfile)~="function"then return false,"File read/write/delete APIs required"end
        I.Fetching=true
        local resolved,fromLink=ResolveMacroInput(raw)
        I.Fetching=false
        if not resolved then return false,fromLink end
        if I.Busy or opts.Busy()then return false,"Stop recording and Auto Playback before importing"end
        raw=resolved
        local ok,data=pcall(opts.HTTP.JSONDecode,opts.HTTP,raw)
        if not ok or type(data)~="table"then return false,fromLink and "Link did not return macro JSON; copy a fresh Discord file link"or "Invalid JSON; paste the complete macro file"end
        if not table.find(opts.Games,data.Game)and not (opts.Legacy and opts.Legacy(data))then return false,"This macro belongs to another game"end
        if type(data.Actions)~="table"or #data.Actions==0 or #data.Actions>50000 then return false,"Invalid macro actions"end
        local count=0
        for key,action in pairs(data.Actions)do
            count=count+1
            if type(key)~="number"or key%1~=0 or key<1 or key>#data.Actions or type(action)~="table"
                or not table.find(opts.Kinds,action[opts.KindKey])then return false,"Invalid macro action"end
            for _,field in ipairs({"Time","At","Wave","WaveAt","WaveTime"})do
                local value=action[field]
                if value~=nil and (type(value)~="number"or value~=value or value<0 or value==math.huge)then return false,"Invalid action "..field end
            end
        end
        if count~=#data.Actions then return false,"Macro actions must be a list"end
        ok,data=pcall(cleanData,data,0)
        if not ok then return false,tostring(data)end
        if opts.Validate then
            local called,valid,why=pcall(opts.Validate,data)
            if not called or not valid then return false,called and (why or "Invalid macro data")or "Invalid macro data"end
        end
        name=tostring(name or ""):match("^%s*(.-)%s*$")
        if name==""then name=type(data.Name)=="string"and data.Name or type(data.Profile)=="string"and data.Profile or "Imported Macro"end
        name=opts.Clean(name)
        local lower=name:lower()
        if name==""or lower=="settings"or lower=="hubconfig"or lower=="playback_debug"or lower:match("_config$")then return false,"Enter another macro name"end
        local file=opts.Path(name)
        if not file then return false,"Invalid macro name"end
        local checked,exists=pcall(isfile,file)
        if not checked then return false,"Cannot check existing macro files"end
        if exists then return false,"Macro name already exists; choose another name"end
        local restore=snapshot()
        I.Busy=true
        local called,why=pcall(function()
            local encoded=opts.HTTP:JSONEncode(data)
            writefile(file..".pending",encoded)
            assert(readfile(file..".pending")==encoded,"Pending verification failed")

            assert(not isfile(file),"Macro name already exists")
            I.Created=file
            writefile(file,encoded);assert(readfile(file)==encoded,"Save verification failed")
            local loaded,reason=opts.Load(name)
            assert(loaded,reason or "Macro failed its game-specific validation")
        end)
        if not called then
            restore()
            if I.Created then pcall(delfile,I.Created)end
            I.Created=nil;I.Busy=false;pcall(delfile,file..".pending")
            return false,"Import failed: "..tostring(why)
        end
        I.Created=nil;I.Busy=false;pcall(delfile,file..".pending")
        return true,name,#data.Actions
    end
    opts.Owner.MacroImport=I
    opts.Tab:Section({Title="Import Macro",Side="Right"})
    local nameValue,jsonValue="",""
    local nameInput=opts.Tab:Input({Title="Macro Name",Placeholder="Imported Macro",Value="",Callback=function(value)nameValue=tostring(value or "")end})
    local jsonInput=opts.Tab:Input({Title="Macro JSON (paste code)",Type="Textarea",ClearTextOnFocus=false,Placeholder="{ ... }",Value="",Callback=function(value)jsonValue=tostring(value or "")end})
    
    -- Cactus Hub macro workspace additions: these ONLY populate the existing import field.
    local cactusFileName = ""
    opts.Tab:Input({Title="Local Macro File (.json / .txt)",Desc="File inside ToiletMastersTD_Macros",Placeholder="my-macro.json",Value="",Callback=function(v) cactusFileName=tostring(v or "") end})
    opts.Tab:Button({Title="Load Local JSON Into Import Box",Icon="folder-open",Callback=function()
        local name=cactusFileName:match("^%s*(.-)%s*$")
        local ext=name:match("%.([%a]+)$")
        if not name:match("^[%w_%- ]+%.[%a]+$") or not ext or (ext:lower()~="json" and ext:lower()~="txt") then
            opts.Notify("Use a .json or .txt filename only (no directory)")
            return
        end
        if type(readfile)~="function" then opts.Notify("Local file reading is unavailable") return end
        local ok,data=pcall(readfile,"ToiletMastersTD_Macros/"..name)
        if not ok or type(data)~="string" then opts.Notify("Could not read ToiletMastersTD_Macros/"..name) return end
        if #data>1048576 then opts.Notify("Import text exceeds 1 MB") return end
        jsonValue=data
        jsonInput:Set(data)
        opts.Notify("File loaded. Select Import Macro to validate and save it")
    end})
    opts.Tab:Button({Title="Paste JSON From Clipboard",Icon="clipboard-paste",Callback=function()
        if type(getclipboard)~="function" then opts.Notify("Clipboard reading is unavailable") return end
        local ok,data=pcall(getclipboard)
        if not ok or type(data)~="string" or data=="" then opts.Notify("Clipboard has no readable text") return end
        if #data>1048576 then opts.Notify("Import text exceeds 1 MB") return end
        jsonValue=data
        jsonInput:Set(data)
        opts.Notify("Clipboard loaded. Select Import Macro to validate and save it")
    end})

opts.Tab:Button({Title="Import Macro",Icon="download",Callback=function()
        local ok,name,count=I.Import(jsonValue,nameValue)
        if not ok then opts.Notify(name);return end
        nameValue=name;jsonValue="";nameInput:Set(name);jsonInput:Set("")
        local refreshed,err=pcall(opts.Refresh,name)
        opts.Notify("Imported "..name.." ("..tostring(count).." actions)"..(not refreshed and "; reopen Select Macro to refresh"or ""))
    end})
end
