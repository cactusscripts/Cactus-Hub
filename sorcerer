    local function imageIdentity(object)
        local names=control.PlayerNames or {}
        local node=object.Parent
        for _=1,2 do
            if not node then break end
            if names[node.Name]then return true end
            for _,label in ipairs(node:GetChildren())do
                if label:IsA("TextLabel")or label:IsA("TextButton")then
                    local key=label.Name:lower():gsub("[^%a]","")
                    if key=="username"or key=="displayname"or key=="playername"or key=="name"or key=="namelabel"then
                        local text=tostring(label.Text):gsub("<[^>]+>",""):match("^%s*(.-)%s*$")
                        if names[text]or settings.HideName and text=="Player"then return true end
                    end
