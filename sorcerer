            local function element(kind, cfg)
                local description = options.Descriptions and options.Descriptions[cfg.Title] or cfg.Desc
                local widget = {Value = cfg.Value, Title = cfg.Title}
                local raw, muting = nil, 1
                local values = copy(cfg.Values)
                local function multiArray(value)
                    local selected, output = {}, {}
                    if type(value) == "table" then
                        for _, v in ipairs(value) do selected[v] = true end
                        for k, v in pairs(value) do if type(k) == "string" and v == true then selected[k] = true end end
                    end
                    for _, name in ipairs(values) do if selected[name] then output[#output + 1] = name end end
                    return output
                end
                local function selectedValue(value)
                    if cfg.Multi then return multiArray(value) end
                    if type(value) == "table" then value = value[1] end
                    for _, option in ipairs(values) do if option == value then return value end end
                    if cfg.AllowNone == false then return values[1] end
                    return nil
                end
                local function callback(value)
                    if muting > 0 or not active() then return end
                    if kind == "Dropdown" then value = selectedValue(value) end
                    widget.Value = type(value) == "table" and copy(value) or value
                    if cfg.Callback then return cfg.Callback(value) end
                end
                local function silent(fn)
                    muting = muting + 1
                    local ok, reason = pcall(fn)
                    muting = muting - 1
                    if not ok then error(reason, 0) end
                end
                local nativeConfig = {Name = cfg.Title, Description = description, Default = cfg.Value,
                    Callback = callback}

                if kind == "Paragraph" then
                    raw = container():Paragraph({Header = cfg.Title or "", Body = tostring(description or "")})
                elseif kind == "Button" then
                    raw = container():Button(nativeConfig)
                elseif kind == "Toggle" then
                    nativeConfig.Default = cfg.Value == true
                    widget.Value = nativeConfig.Default
                    raw = container():Toggle(nativeConfig)
                elseif kind == "Dropdown" then
                    nativeConfig.Options = copy(values)
                    nativeConfig.Default = selectedValue(cfg.Value)
                    nativeConfig.Multi = cfg.Multi == true
                    nativeConfig.Required = cfg.AllowNone == false
                    nativeConfig.Search = cfg.SearchBarEnabled ~= false
                    widget.Value = nativeConfig.Default
                    raw = container():Dropdown(nativeConfig)
                elseif kind == "Slider" then
                    local range = cfg.Value or {}
                    nativeConfig.Minimum, nativeConfig.Maximum = range.Min or 0, range.Max or 100
                    nativeConfig.Default = range.Default or nativeConfig.Minimum
                    local step, precision = tonumber(cfg.Step) or 1, 0
                    if step <= 0 then step = 1 end
                    while precision < 4 and math.abs(step * 10 ^ precision - math.floor(step * 10 ^ precision + .5)) > 1e-7 do
                        precision = precision + 1
                    end
                    nativeConfig.Precision = precision
                    nativeConfig.Callback = function(value)
                        local stepped = nativeConfig.Minimum + math.floor((value - nativeConfig.Minimum) / step + .5) * step
                        stepped = math.max(nativeConfig.Minimum, math.min(nativeConfig.Maximum, stepped))
                        if raw and math.abs(stepped - value) > 1e-7 then raw:UpdateValue(stepped) end
                        return callback(stepped)
                    end
                    widget.Value = nativeConfig.Default
                    raw = container():Slider(nativeConfig)
                elseif kind == "Input" then
                    nativeConfig.Default = tostring(cfg.Value or "")
                    nativeConfig.Placeholder = cfg.Placeholder
                    widget.Value = nativeConfig.Default
                    raw = container():Input(nativeConfig)
                else
                    error("Unsupported WindUI control: " .. tostring(kind))
                end
                widget.Native = raw
                function widget:Set(value)
                    if closed then return end
                    silent(function()
                        if kind == "Toggle" then
                            widget.Value = value == true
                            raw:UpdateState(widget.Value)
                        elseif kind == "Dropdown" then
                            widget.Value = selectedValue(value)
                            raw:UpdateSelection(widget.Value or {}, true)
                        elseif kind == "Slider" then
                            widget.Value = tonumber(value) or widget.Value
                            raw:UpdateValue(widget.Value)
                        elseif kind == "Input" then
                            widget.Value = tostring(value or "")
                            raw:UpdateText(widget.Value, true)
                        end
                    end)
                end
                widget.Select = widget.Set
                function widget:Refresh(newValues)
                    assert(kind == "Dropdown", "Only dropdown lists can refresh")
                    if closed then return end
                    local previous = widget.Value
                    values = copy(newValues)
                    silent(function()
                        raw:ClearOptions()
                        raw:InsertOptions(values)
                        widget.Value = selectedValue(previous)
                        raw:UpdateSelection(widget.Value or {}, true)
                    end)
                end
                function widget:SetTitle(title)
                    if closed then return end
                    widget.Title = title
                    if kind == "Paragraph" then return raw:UpdateHeader(tostring(title or "")) end
                    if raw.UpdateName then return raw:UpdateName(title) end
                end
                function widget:SetDesc(description)
                    if closed then return end
                    if kind == "Paragraph" then return raw:UpdateBody(tostring(description or "")) end
                    if raw.UpdateDescription then return raw:UpdateDescription(description) end
