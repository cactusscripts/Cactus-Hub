		local revealed = entry.revealFunc and entry.revealFunc()
		if revealed then task.wait() end
		if entry.scrollFrame and entry.element then
			task.wait()
			local elem = entry.element
			local sf = entry.scrollFrame
			local relY = elem.AbsolutePosition.Y - sf.AbsolutePosition.Y + sf.CanvasPosition.Y
			local targetY = math.clamp(relY - sf.AbsoluteSize.Y / 3, 0, math.max(0, sf.AbsoluteCanvasSize.Y - sf.AbsoluteSize.Y))
			sf.CanvasPosition = Vector2.new(0, targetY)

			activeFlashId = activeFlashId + 1
			local thisFlash = activeFlashId
			restoreHighlights()

			local toFlash = {}
			for _, child in pairs(elem:GetDescendants()) do
				if (child:IsA("TextLabel") or child:IsA("TextButton")) and child.TextTransparency < 0.9 then
					table.insert(toFlash, {obj = child, origTransparency = child.TextTransparency, origColor = child.TextColor3})
				end
			end
			flashHighlights = toFlash

			local function setFlash(bright)
				if thisFlash ~= activeFlashId then return end
				for _, h in pairs(toFlash) do
					if h.obj and h.obj.Parent then
						h.obj.TextTransparency = bright and 0 or h.origTransparency
						h.obj.TextColor3 = bright and Color3.fromRGB(195, 220, 255) or h.origColor
					end
				end
			end

			task.spawn(function()
				for _ = 1, 3 do
					setFlash(true)
					task.wait(0.38)
					setFlash(false)
					task.wait(0.38)
				end
				if thisFlash == activeFlashId then
					restoreHighlights()
				end
			end)
		end
	end

