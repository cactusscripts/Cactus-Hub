    end
    local function isAvatar(object)
        local uri="";pcall(function()uri=tostring(object.Image):lower()end)
        if uri:find("rbxthumb://",1,true)and (uri:find("type=avatar",1,true)or uri:find("type=headshot",1,true))then return true end
        if uri:find("headshot%-thumbnail")or uri:find("avatar%-thumbnail")or uri:find("avatar%.ashx")or uri:find("headshot%.ashx")
            or uri:find("thumbnails.roblox.com/v1/users/",1,true)then return true end
        local name=object.Name:lower():gsub("[^%a]","")
        if name:find("avatar",1,true)or name:find("headshot",1,true)or name:find("portrait",1,true)
            or name=="playericon"or name=="playerimage"or name=="profilepicture"then return true end
