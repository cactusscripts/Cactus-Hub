	end

	local function parseCompact(value)
		if type(value) ~= "string" then
			return nil
		end

		local month, day, year, hour, minute =
			value:match("^(%d+)/(%d+)/(%d+)_(%d+):(%d+)$")

		if not month then
			return nil
		end

		year = tonumber(year)

		if year < 100 then
			year = 2000 + year
		end

		return os.time({
			year = year,
			month = tonumber(month),
			day = tonumber(day),
			hour = tonumber(hour),
			min = tonumber(minute),
			sec = 0
		})
	end

	local function parseISO(value)
		if type(value) ~= "string" then
			return nil
		end

		local year, month, day, hour, minute, second =
			value:match("^(%d+)-(%d+)-(%d+)T(%d+):(%d+):([%d%.]+)")

		if not year then
			return nil
		end

		return os.time({
			year = tonumber(year),
			month = tonumber(month),
			day = tonumber(day),
			hour = tonumber(hour),
			min = tonumber(minute),
			sec = math.floor(tonumber(second))
		})
	end

	local expiry

	if type(expiresAt) == "number" then
		if expiresAt == 0
			or expiresAt == -1
			or expiresAt == math.huge
		then
			keyTimerInfoLabel:UpdateName(prefix)
			return
		end

		expiry = expiresAt
	elseif type(expiresAt) == "string" then
		expiry = parseCompact(expiresAt) or parseISO(expiresAt)
	end

	if not expiry then
		keyTimerInfoLabel:UpdateName("Key expiry unavailable")
		return
	end

	local function formatRemaining(seconds)
		seconds = math.floor(seconds)

		if seconds <= 0 then
			return "Key expired"
		end

		local days = math.floor(seconds / 86400)
		local hours = math.floor((seconds % 86400) / 3600)
		local minutes = math.floor((seconds % 3600) / 60)
		local secs = seconds % 60

		if days > 0 then
			return string.format("%s · %dd %dh left", prefix, days, hours)
		elseif hours > 0 then
			return string.format("%s · %dh %dm left", prefix, hours, minutes)
		else
			return string.format("%s · %dm %ds left", prefix, minutes, secs)
		end
	end


	local lastDisplayedSecond

	local function updateTimer()
		local remaining = expiry - os.time()
		local currentSecond = math.floor(remaining)

		if currentSecond ~= lastDisplayedSecond then
			lastDisplayedSecond = currentSecond
			keyTimerInfoLabel:UpdateName(formatRemaining(remaining))
		end

		if remaining <= 0 and _keyTimerConn then
			_keyTimerConn:Disconnect()
			_keyTimerConn = nil
		end
	end

