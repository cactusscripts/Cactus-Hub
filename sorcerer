do
    local function NewMoveAround(options)
        local c = { Alive = true, Enabled = false, Phase = 1, Turns = 0 }
        function c.Stop()
            local h = c.Humanoid
            c.Humanoid, c.Root, c.Center, c.Direction = nil, nil, nil, nil
            if h and h.Parent then h:Move(Vector3.new(0, 0, 0), false) end
        end
        local patterns
        function c.Step(dt)
            if not c.Alive or not options.Alive() then c.Destroy(); return end
            if not c.Enabled or not options.Allowed() then c.Stop(); return end
            local char = options.Player.Character
            local h = char and char:FindFirstChildOfClass("Humanoid")
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if not h or not root or h.Health <= 0 or h.Sit then c.Stop(); return end
            if c.Root ~= root then
                c.Stop(); c.Root, c.Humanoid, c.Center = root, h, root.Position
                c.Phase, c.Turns, c.Point = 1, 0, 1
            end
            patterns = patterns or {
                {{5,0},{3.54,3.54},{0,5},{-3.54,3.54},{-5,0},{-3.54,-3.54},{0,-5},{3.54,-3.54}},
                {{-4,-4},{4,-2},{-4,0},{4,2},{-4,4},{4,2},{-4,0},{4,-2}},
                {{0,0},{3.54,3},{5,0},{3.54,-3},{0,0},{-3.54,3},{-5,0},{-3.54,-3}},
                {{4,4},{-4,4},{-4,-4},{4,-4}},
            }
            local points = patterns[c.Phase]
            local function destination()
                local p = points[c.Point]
                return c.Center + Vector3.new(p[1], 0, p[2])
            end
            local target = destination()
            local delta = target - root.Position
            delta = Vector3.new(delta.X, 0, delta.Z)
            if delta.Magnitude < 1.6 then
                c.Point = c.Point + 1
                if c.Point > #points then
                    c.Point, c.Turns = 1, c.Turns + 1
                    if c.Turns >= 2 then c.Phase, c.Turns = c.Phase % 4 + 1, 0 end
                    points = patterns[c.Phase]
                end
                target = destination(); delta = target - root.Position
                delta = Vector3.new(delta.X, 0, delta.Z)
            end
            local desired = delta.Magnitude > .1 and delta.Unit or Vector3.new(0, 0, 0)
            local alpha = math.min(1, dt * 12)
            local direction = c.Direction and c.Direction:Lerp(desired, alpha) or desired
            c.Direction = direction
            if direction.Magnitude > .1 then direction = direction.Unit end
            h:Move(direction, false)
            if not c.LastPosition or (root.Position - c.LastPosition).Magnitude > .5 then
                c.LastPosition, c.StuckAt = root.Position, os.clock()
            elseif os.clock() - c.StuckAt > 3 then
                c.Point = c.Point % #points + 1; c.StuckAt = os.clock()
            end
        end
        function c.Set(value)
            c.Enabled = value == true
            options.Save(c.Enabled)
            if not c.Enabled then
                c.Stop()
                if c.Bound then game:GetService("RunService"):UnbindFromRenderStep(options.Key); c.Bound = nil end
            elseif not c.Bound then
                c.Bound = true
                game:GetService("RunService"):BindToRenderStep(options.Key, 201, c.Step)
            end
        end
        function c.Destroy()
            if not c.Alive then return end
            c.Alive = false; c.Stop()
            if c.Bound then game:GetService("RunService"):UnbindFromRenderStep(options.Key); c.Bound = nil end
        end
        return c
    end
    local options = {Key="KeroMoveAround_toiletmasters",Owner=H,Player=P,Tab=misc,Window=window,Enabled=S.MoveAround,
 Alive=function()return H.Running end,Allowed=function()return game.PlaceId~=H.LobbyId and not H.Ended and not H.Recording and not H.Teleporting end,
 Save=function(enabled) S.MoveAround=enabled;H.QueueSave() end}
    local previous = options.Owner.MoveAroundController
    if previous then previous.Destroy() end
    local control = NewMoveAround(options)
    options.Owner.MoveAroundController = control
    local destroy = options.Owner.Destroy
    if type(destroy) == "function" then
        options.Owner.Destroy = function(...) control.Destroy(); return destroy(...) end
    end
    if options.AddToggle then
        options.AddToggle(control.Set, options.Enabled == true)
    else
        options.Tab:Toggle({ Title = "Move Around", Value = options.Enabled == true,
            Callback = function(value) control.Set(value) end })
    end
    if options.Enabled == true then control.Set(true) end
end

