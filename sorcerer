            end)end
        end
        local roots={}
        pcall(function()local gui=player:FindFirstChildOfClass("PlayerGui");if gui then roots[#roots+1]=gui end end)
        for _,name in ipairs({"CoreGui","Workspace"})do pcall(function()roots[#roots+1]=game:GetService(name)end)end
        local function watchRoot(root)
            if root.DescendantAdded then control.ImageConnections[#control.ImageConnections+1]=root.DescendantAdded:Connect(function(object)
                task.defer(function()if control.Alive and control.Enabled then pcall(watch,object)end end)
            end)end
            local ok,objects=pcall(root.GetDescendants,root)
