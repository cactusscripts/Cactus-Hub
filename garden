        return {Version=2,UserId=options.UserId,UniverseId=options.UniverseId,Elapsed=0,Wins=0,Losses=0,
            Draws=0,Completed=0,Totals={},Rounds={},Order={},Labels={}}
    end
    M.Data = fresh()
    local function restore(saved)
        if type(saved)~="table" or saved.Version~=2 or saved.UserId~=options.UserId or saved.UniverseId~=options.UniverseId then return false end
        if type(saved.Totals)~="table" or type(saved.Rounds)~="table" or type(saved.Order)~="table" then return false end
        local d=fresh()
        for _,k in ipairs({"Elapsed","Wins","Losses","Draws","Completed"}) do if not valid(saved[k]) then return false end;d[k]=saved[k] end
        for k,v in pairs(saved.Totals) do if type(k)=="string" and #k<=160 and valid(v) then d.Totals[k]=v end end
        for _,k in ipairs(saved.Order) do
            local r=type(k)=="string" and saved.Rounds[k]
            if type(r)=="table" and type(r.Rewards)=="table" and #d.Order<256 then
                local copy={Rewards={},Outcome=(r.Outcome=="Win" or r.Outcome=="Loss" or r.Outcome=="Draw") and r.Outcome or nil,Suppress=r.Suppress==true}
                for field,v in pairs(r.Rewards) do if type(field)=="string" and valid(v) then copy.Rewards[field]=v end end
                d.Rounds[k]=copy;d.Order[#d.Order+1]=k
            end
        end
        d.LatestKey=d.Rounds[saved.LatestKey] and saved.LatestKey or nil
        d.Cursors=type(saved.Cursors)=="table" and saved.Cursors or {}
        M.Data=d;return true
    end
    local ok,saved=pcall(options.Read)
    if not ok or not restore(saved) then local backupOK,backup=pcall(options.ReadBackup or function()end);if backupOK then restore(backup) end end
    M.Data.Cursors=M.Data.Cursors or {}
    function M.Tick()
        local now=options.Clock();M.Data.Elapsed=M.Data.Elapsed+math.max(0,now-M.LastTick);M.LastTick=now
    end
    function M.Apply(key,outcome,rewards)
        local d=M.Data;local r=d.Rounds[key]
        if r and r.Suppress then return false end
        local changed=false
        if not r then r={Rewards={}};d.Rounds[key]=r;d.Order[#d.Order+1]=key;d.Completed=d.Completed+1;changed=true end
        if not r.Outcome and (outcome=="Win" or outcome=="Loss" or outcome=="Draw") then
            r.Outcome=outcome;local field=outcome=="Win" and "Wins" or outcome=="Loss" and "Losses" or "Draws"
            d[field]=d[field]+1;changed=true
        end
        for k,v in pairs(type(rewards)=="table" and rewards or {}) do
            if type(k)=="string" and #k>0 and #k<=160 and valid(v) and (r.Rewards[k]==nil or v>r.Rewards[k]) then
                d.Totals[k]=(d.Totals[k] or 0)+v-(r.Rewards[k] or 0);r.Rewards[k]=v;changed=true
            end
        end
        while #d.Order>256 do d.Rounds[table.remove(d.Order,1)]=nil end
        d.LatestKey=key;M.Dirty=M.Dirty or changed;return changed
    end
    function M.Save()
        M.Tick();local success,result=pcall(options.Write,M.Data)
        if success and result~=false then M.Dirty=false;return true end
        M.Dirty=true;return false
    end
    function M.Reset(key)
        local cursors=M.Data.Cursors;M.Data=fresh();M.Data.Cursors=cursors
        if key then M.Data.Rounds[key]={Rewards={},Suppress=true};M.Data.Order={key} end
        M.LastTick=options.Clock();M.Dirty=true;return M.Save()
    end
    function M.Snapshot()
        local d=M.Data;local pending=0
        for _,r in pairs(d.Rounds) do if not r.Outcome and not r.Suppress then pending=pending+1 end end
